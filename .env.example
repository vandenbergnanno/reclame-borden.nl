# Supabase project settings (Project Settings > API in het Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen gebruikt in server-side code (API routes), nooit blootstellen aan de browser.
SUPABASE_SERVICE_ROLE_KEY=

# Naam van de Supabase Storage-bucket waar klantbijlagen in worden opgeslagen.
SUPABASE_STORAGE_BUCKET=aanvraag-bijlagen

# Gedeeld wachtwoord voor medewerkers om bij /intern te komen. Simpele poort, geen individuele
# accounts — vervang door Supabase Auth zodra er een project gekoppeld is (zie PROGRESS.md).
INTERN_WACHTWOORD=

# Alleen op "true" zetten als deze app achter een EIGEN, zelf ingerichte reverse proxy draait
# (bijv. nginx) die het verbindende IP correct aan x-forwarded-for toevoegt. Zonder dit (de
# standaard) vertrouwt lib/security/rateLimit.ts geen enkele proxy-header van de bezoeker, zodat
# niemand de rate limiting kan omzeilen door zelf een x-forwarded-for mee te sturen. Draait de app
# op Vercel, dan is dit niet nodig: Vercel's eigen, niet-spoofbare IP-detectie wordt dan altijd
# gebruikt, ongeacht deze instelling.
EIGEN_REVERSE_PROXY=false

# Optioneel, nog niet in gebruik: API-token van replicate.com voor echte beeldgeneratie in
# lib/ai/generateDesign.ts. Zolang dit leeg is, blijft die functie de vaste testafbeelding
# teruggeven — zie de TODO's in dat bestand.
REPLICATE_API_TOKEN=

# Basis-URL van de site, gebruikt om volledige links te bouwen in de voorstel-e-mail (naar de
# afbeelding en naar /voorstel/[id]) — e-mailclients kunnen geen relatieve paden laden. Voor
# lokaal ontwikkelen mag dit leeg blijven (valt terug op http://localhost:3000); zet 'm bij een
# echte deployment op het publieke domein.
APP_URL=

# Optioneel, nog niet in gebruik: API-key van resend.com om de voorstel-e-mail écht te versturen
# in lib/email/sendProposalEmail.ts. Zolang dit leeg is, wordt de e-mail alleen naar de console
# gelogd. Maak een gratis account op resend.com (100 e-mails/dag) om een key te krijgen.
RESEND_API_KEY=

# Afzender voor die e-mail, bijv. "De Mediagraaf <voorstel@demediagraaf.nl>". Zonder eigen
# geverifieerd domein bij Resend kun je lokaal testen met de standaardwaarde hieronder
# (onboarding@resend.dev), die geldt als je dit leeg laat.
RESEND_AFZENDER=

# Cloudflare Turnstile (onzichtbare/"managed" bot-check) op het aanvraagformulier van de
# ontwerptool (/aanvraag, zie lib/ontwerptool/reclamebord-maker.html) en op klant-inloggen/
# -registreren (/inloggen, zie app/inloggen/KlantLoginForm.tsx + het Supabase-dashboard,
# Authentication > Attack Protection). Beide sleutels komen uit het Cloudflare-dashboard
# (dash.cloudflare.com > Turnstile > Add site, widget mode "Invisible").
#
# Lokaal testen zonder eigen Cloudflare-account: gebruik Cloudflare's officiële testsleutels
# (werken alleen op localhost/127.0.0.1, geven altijd een geldig token):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Gedrag als TURNSTILE_SECRET_KEY leeg is: in development (NODE_ENV=development, dus `next dev`)
# laat de server dan alles door, met een duidelijke waarschuwing in de serverconsole. In
# productie (NODE_ENV=production) weigert de server juist elke aanvraag met een foutmelding in de
# logs -- "geen sleutel" mag in productie nooit stilzwijgend "geen controle" betekenen.
#
# Mag naar de browser (zit al in elke pagina die de widget laadt).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Nooit naar de browser -- alleen gebruikt om een token server-side te verifiëren.
TURNSTILE_SECRET_KEY=
