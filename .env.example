# Supabase project settings (Project Settings > API in het Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen gebruikt in server-side code (API routes), nooit blootstellen aan de browser.
SUPABASE_SERVICE_ROLE_KEY=

# Naam van de Supabase Storage-bucket waar klantbijlagen in worden opgeslagen.
SUPABASE_STORAGE_BUCKET=aanvraag-bijlagen

# Gedeeld wachtwoord voor medewerkers om bij /intern te komen. Simpele poort, geen individuele
# accounts — vervang door Supabase Auth zodra er een project gekoppeld is (zie PROGRESS.md).
INTERN_WACHTWOORD=

# Optioneel, nog niet in gebruik: API-token van replicate.com voor echte beeldgeneratie in
# lib/ai/generateDesign.ts. Zolang dit leeg is, blijft die functie de vaste testafbeelding
# teruggeven — zie de TODO's in dat bestand.
REPLICATE_API_TOKEN=
