# Supabase project settings (Project Settings > API in het Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen gebruikt in server-side code (API routes), nooit blootstellen aan de browser.
SUPABASE_SERVICE_ROLE_KEY=

# Naam van de Supabase Storage-bucket waar klantbijlagen in worden opgeslagen.
SUPABASE_STORAGE_BUCKET=aanvraag-bijlagen

# Gedeeld wachtwoord voor medewerkers om bij /intern te komen. Simpele poort, geen individuele
# accounts — vervang door Supabase Auth zodra er een project gekoppeld is (zie PROGRESS.md).
INTERN_WACHTWOORD=

# Optioneel, nog niet in gebruik: API-token van replicate.com voor echte beeldgeneratie in
# lib/ai/generateDesign.ts. Zolang dit leeg is, blijft die functie de vaste testafbeelding
# teruggeven — zie de TODO's in dat bestand.
REPLICATE_API_TOKEN=

# Basis-URL van de site, gebruikt om volledige links te bouwen in de voorstel-e-mail (naar de
# afbeelding en naar /voorstel/[id]) — e-mailclients kunnen geen relatieve paden laden. Voor
# lokaal ontwikkelen mag dit leeg blijven (valt terug op http://localhost:3000); zet 'm bij een
# echte deployment op het publieke domein.
APP_URL=

# Optioneel, nog niet in gebruik: API-key van resend.com om de voorstel-e-mail écht te versturen
# in lib/email/sendProposalEmail.ts. Zolang dit leeg is, wordt de e-mail alleen naar de console
# gelogd. Maak een gratis account op resend.com (100 e-mails/dag) om een key te krijgen.
RESEND_API_KEY=

# Afzender voor die e-mail, bijv. "De Mediagraaf <voorstel@demediagraaf.nl>". Zonder eigen
# geverifieerd domein bij Resend kun je lokaal testen met de standaardwaarde hieronder
# (onboarding@resend.dev), die geldt als je dit leeg laat.
RESEND_AFZENDER=
